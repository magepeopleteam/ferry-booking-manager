{
  "name": "magepeople/magepeople-ferry-booking-system",
  "description": "Production-grade ferry booking and ferry operations management for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "FBM\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FBM\\Tests\\": "tests/unit/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "find src -name \"*.php\" -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "test": "phpunit",
    "build:admin": "npm --prefix apps/admin ci && npm --prefix apps/admin run build"
  }
}
